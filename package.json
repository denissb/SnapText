{
  "name": "SnapText",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "android": "adb reverse tcp:8081 tcp:8081 && react-native run-android",
    "ios": "react-native run-ios --simulator=\"iPhone 16\"",
    "start": "react-native rnx-start",
    "bundle": "yarn bundle:ios && yarn bundle:android",
    "bundle:ios": "react-native rnx-bundle --platform ios --entry-file index.tsx",
    "bundle:android": "react-native rnx-bundle --platform android --entry-file index.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "release": "cd android && ./gradlew bundleRelease",
    "check-dependencies": "yarn rnx-align-deps --requirements react-native@0.81.4",
    "align-deps": "yarn rnx-align-deps --write",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "dependencies": {
    "@infinitered/react-native-mlkit-document-scanner": "^5.0.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/app": "26.2.0",
    "@react-native-vector-icons/feather": "^13.1.2",
    "@types/react-native-vector-icons": "^6.4.18",
    "expo": "~57.0.19",
    "expo-file-system": "^57.0.2",
    "expo-intent-launcher": "^57.0.1",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-i18next": "17.0.11",
    "react-native": "0.86.2",
    "react-native-bootsplash": "^7.3.2",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-fs": "^2.20.0",
    "react-native-image-crop-picker": "0.51.1",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "^5.9.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-vision-camera": "5.2.2",
    "react-native-vision-camera-barcode-scanner": "^5.2.2",
    "react-native-vision-camera-ocr-plus": "^2.0.6",
    "react-native-vision-camera-worklets": "^5.2.3",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "^0.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@rnx-kit/align-deps": "^4.0.4",
    "@rnx-kit/cli": "^2.0.2",
    "@rnx-kit/metro-config": "^2.2.4",
    "@tsconfig/react-native": "^3.0.9",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "babel-preset-expo": "~57.0.6",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.6.3",
    "prettier": "^3.4.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@3.8.7",
  "rnx-kit": {
    "bundle": {
      "plugins": [
        [
          "@rnx-kit/metro-plugin-duplicates-checker",
          {
            "ignoredModules": [
              "react-is",
              "@babel/core",
              "@babel/runtime"
            ]
          }
        ]
      ],
      "platforms": {
        "ios": {
          "bundleOutput": "ios/main.jsbundle",
          "sourcemapOutput": "ios/main.jsbundle.map"
        },
        "android": {
          "bundleOutput": "android/main.jsbundle",
          "sourcemapOutput": "android/main.jsbundle.map"
        }
      },
      "treeShake": true
    },
    "kitType": "app",
    "typescriptValidation": false,
    "alignDeps": {
      "requirements": [
        "react-native@0.81"
      ],
      "capabilities": [
        "animation",
        "babel-preset-react-native",
        "core",
        "core-android",
        "core-ios",
        "filesystem",
        "jest",
        "modal",
        "react",
        "react-test-renderer",
        "webview"
      ]
    }
  }
}
